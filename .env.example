# Google Sheets Configuration
# Path to your service account JSON key file (download from Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# The ID of your Google Sheet (from the URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_sheet_id_here

# Name of the worksheet/tab to write to (default: first sheet)
WORKSHEET_NAME=Sheet1

# --- Data Source Configuration ---
# Set MODE to "api" or "scrape"
MODE=api

# If MODE=api: the endpoint URL to fetch data from
API_URL=https://api.example.com/data

# Optional: API key if required (sent as Authorization: Bearer header)
API_KEY=

# If MODE=scrape: the URL to scrape
SCRAPE_URL=https://example.com/data

# CSS selector to target the data table (used in scrape mode)
SCRAPE_TABLE_SELECTOR=table
